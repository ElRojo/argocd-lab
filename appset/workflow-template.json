{
  "kind": "ApplicationSet",
  "apiVersion": "argoproj.io/v1alpha1",
  "metadata": {
    "name": "argo-workflow-template",
    "namespace": "argocd",
    "labels": {}
  },
  "spec": {
    "generators": [
      {
        "list": {
          "elements": [
            {
              "clusterName": "default",
              "folderPath": "workflowtemplates"
            }
          ]
        }
      }
    ],
    "template": {
      "metadata": {
        "name": "argo-workflow-template-{{clusterName}}",
        "namespace": "argocd"
      },
      "spec": {
        "source": {
          "repoURL": "https://github.com/ElRojo/argocd-lab.git",
          "targetRevision": "main",
          "path": "gitops/{{folderPath}}/{{clusterName}}/workflowTemplate",
          "directory": {
            "recurse": true
          }
        },
        "destination": {
          "namespace": "argocd",
          "name": "{{clusterName}}"
        },
        "project": "default",
        "syncPolicy": {
          "automated": {
            "prune": true,
            "selfHeal": true,
            "enabled": true
          }
        }
      }
    }
  },
  "status": {}
}
